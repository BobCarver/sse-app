{
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env --allow-read --allow-write app/src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-write app/src/main.ts",
    "demo": "DEMO=1 deno run --watch --allow-net --allow-env --allow-read --allow-write app/src/main.ts",
    "demo:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f docker/postgres/demo/demo_seed.sql",
    "check": "deno check --quiet app scripts",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "static": "deno task check && deno task lint && deno task fmt:check && deno task build:verify",
    "test": "deno task test:unit && deno task test:frontend && deno task test:contract && deno task test:integration",
    "docker:postgres:compose:up": "docker compose -f docker/docker-compose.yml up -d db",
    "docker:postgres:compose:down": "docker compose -f docker/docker-compose.yml down",
    "docker:postgres:db-init": "docker compose -f docker/docker-compose.yml run --rm db-init",
    "docker:postgres:reinit": "docker compose -f docker/docker-compose.yml down -v && docker compose -f docker/docker-compose.yml up -d db && deno task docker:postgres:db-init",
    "test:unit": "deno test --allow-read --allow-write --allow-env --allow-net=127.0.0.1,localhost app/tests/unit",
    "test:frontend": "deno test --allow-read --allow-env --allow-net=127.0.0.1,localhost app/tests/frontend",
    "test:integration": "deno test --allow-read --allow-write --allow-env --allow-net app/tests/integration",
    "test:contract": "deno test --allow-read --allow-write --allow-env --allow-net=127.0.0.1,localhost app/tests/contract",
    "build:artifacts": "deno run --allow-read --allow-write --allow-run scripts/build_artifacts.ts",
    "links": "deno run --allow-net --allow-env scripts/issue-links.ts",
    "build:verify": "deno task build:artifacts && git diff --exit-code -- public",
    "build": "deno task build:artifacts",
    "test:e2e": "sh tools/e2e.sh"
  },
  "lint": {
    "exclude": ["public/", "node-tests/"]
  },
  "fmt": {
    "include": ["app/", "scripts/"],
    "exclude": ["app/frontend-src/*.html"]
  },
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.11.7",
    "@std/assert": "jsr:@std/assert@^1.0.18",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "b-fuze/deno-dom": "jsr:@b-fuze/deno-dom@0.1.56",

    "qrcode-generator": "npm:qrcode-generator@1.4.4",
    "postgres": "https://deno.land/x/postgresjs@v3.4.5/mod.js"
  },
  "compilerOptions": {
    "lib": ["deno.window", "dom"]
  }
}
